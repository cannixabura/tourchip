/* App name and permission descriptions (Info.plist translations) */
"CFBundleDisplayName" = "Tour en grupo";
"NSLocationWhenInUseUsageDescription" = "TourChip usa tu ubicación mientras usas la app para mostrar la distancia y la dirección al punto de encuentro. Si aceptas compartirla, las personas de tu grupo (incluido el líder) verán tu ubicación en el mapa. Mientras estás en un grupo, se sigue actualizando en segundo plano (se muestra en la barra de estado) para avisos de alejamiento y asistencia automática, y se detiene cuando sales o el grupo termina. Puedes desactivarlo en Ajustes cuando quieras.";
"NSCameraUsageDescription" = "Escanea el código QR de tu líder para unirte o un cupón de grupo, o toma una foto para preguntarle a AIYA, la asistente de IA, por un lugar, un menú o un letrero.";
"NSPhotoLibraryUsageDescription" = "Elige una foto de tu biblioteca como foto de perfil o para mostrársela a AIYA, la asistente de IA.";
"NSMicrophoneUsageDescription" = "Habla por voz con AIYA, la asistente de IA. Tu voz se envía en tiempo real a OpenAI solo durante la llamada y no se graba. Los líderes también usan el micrófono para hablar en vivo: su voz llega solo a quienes escuchan en su propio grupo y no se graba.";

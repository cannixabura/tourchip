/* Permission descriptions and app name (Info.plist translations) */
"CFBundleDisplayName" = "Tour Group";
"NSLocationWhenInUseUsageDescription" = "TourChip uses your location while you use the app to show the distance and direction to the meeting point. If you agree to share, people in your group (including leaders) see your location on the map. While you are in a group, it keeps updating in the background (shown in the status bar) for stray alerts and auto check-in at the meeting point, and stops when you leave or the group ends. You can turn this off in Settings any time.";
"NSCameraUsageDescription" = "Scan your tour leader's join QR code or a group pass, or take a photo to ask AIYA, the AI assistant, about a sight, menu or sign.";
"NSPhotoLibraryUsageDescription" = "Choose a photo from your library as your avatar or to show AIYA, the AI assistant.";
"NSMicrophoneUsageDescription" = "Talk with AIYA, the AI assistant, by voice. Your voice is sent live to OpenAI only during a call and is not recorded. Leaders also use the microphone for live talks: their voice goes only to listeners in their own group and is not recorded. The interpreter also uses the microphone to hear you and the other person; nothing is recorded.";
"NSSpeechRecognitionUsageDescription" = "The free interpreter uses your iPhone's built-in speech recognition (handled by Apple) to turn what you and the other person say into text for translation. TourChip never receives or keeps your voice.";

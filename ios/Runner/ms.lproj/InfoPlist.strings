/* App name and permission descriptions (Info.plist translations) */
"CFBundleDisplayName" = "Tour Group";
"NSLocationWhenInUseUsageDescription" = "TourChip menggunakan lokasi anda semasa aplikasi digunakan untuk menunjukkan jarak dan arah ke tempat berkumpul. Jika anda bersetuju berkongsi, orang dalam kumpulan anda (termasuk ketua) melihat lokasi anda pada peta. Semasa dalam kumpulan, lokasi terus dikemas kini di latar belakang (ditunjukkan pada bar status) untuk amaran tercicir dan daftar hadir automatik, dan berhenti apabila anda keluar atau kumpulan tamat. Anda boleh mematikannya dalam Tetapan bila-bila masa.";
"NSCameraUsageDescription" = "Imbas kod QR untuk sertai daripada ketua anda atau baucar kumpulan, atau ambil foto untuk bertanya AIYA, pembantu AI, tentang tempat menarik, menu atau papan tanda.";
"NSPhotoLibraryUsageDescription" = "Pilih foto daripada pustaka sebagai foto profil anda atau untuk ditunjukkan kepada AIYA, pembantu AI.";
"NSMicrophoneUsageDescription" = "Bercakap dengan AIYA, pembantu AI, melalui suara. Suara anda hanya dihantar terus ke OpenAI semasa panggilan dan tidak dirakam. Ketua juga menggunakan mikrofon untuk siaran panduan: suaranya hanya sampai kepada pendengar dalam kumpulan sendiri dan tidak dirakam. Jurubahasa juga menggunakan mikrofon untuk mendengar anda dan orang lain; tiada apa yang dirakam.";
"NSSpeechRecognitionUsageDescription" = "Jurubahasa percuma menggunakan pengecaman pertuturan terbina dalam iPhone (dikendalikan oleh Apple) untuk menukar kata-kata anda dan orang lain kepada teks untuk diterjemah. TourChip tidak menerima atau menyimpan suara anda.";

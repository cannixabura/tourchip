/* App name and permission descriptions (Info.plist translations) */
"CFBundleDisplayName" = "TourChip";
"NSLocationWhenInUseUsageDescription" = "TourChip menggunakan lokasi anda semasa aplikasi digunakan untuk menunjukkan jarak dan arah ke tempat berkumpul. Jika anda bersetuju berkongsi, orang dalam kumpulan anda (termasuk ketua) melihat lokasi anda pada peta. Anda boleh mematikannya dalam Tetapan bila-bila masa.";
"NSCameraUsageDescription" = "Imbas kod QR untuk sertai daripada ketua anda atau baucar kumpulan.";

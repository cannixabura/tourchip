/* App name and permission descriptions (Info.plist translations) */
"CFBundleDisplayName" = "Grup Tur";
"NSLocationWhenInUseUsageDescription" = "TourChip memakai lokasimu saat aplikasi digunakan untuk menampilkan jarak dan arah ke titik kumpul. Jika kamu setuju berbagi, orang di grupmu (termasuk pemimpin) melihat lokasimu di peta. Selama kamu di grup, lokasi terus diperbarui di latar belakang (terlihat di bilah status) untuk peringatan tertinggal dan absen otomatis, lalu berhenti saat kamu keluar atau grup berakhir. Kamu bisa mematikannya di Pengaturan kapan saja.";
"NSCameraUsageDescription" = "Pindai kode QR bergabung dari pemimpin atau voucher grup, atau ambil foto untuk bertanya kepada AIYA, asisten AI, soal tempat wisata, menu, atau papan tanda.";
"NSPhotoLibraryUsageDescription" = "Pilih foto dari galeri sebagai foto profilmu atau untuk ditunjukkan ke AIYA, asisten AI.";
"NSMicrophoneUsageDescription" = "Bicara dengan AIYA, asisten AI, lewat suara. Suaramu hanya dikirim langsung ke OpenAI selama panggilan dan tidak direkam. Pemimpin juga memakai mikrofon untuk siaran pemandu: suaranya hanya sampai ke pendengar di grupnya sendiri dan tidak direkam. Penerjemah juga memakai mikrofon untuk mendengar kamu dan lawan bicara; tidak ada yang direkam.";
"NSSpeechRecognitionUsageDescription" = "Penerjemah gratis memakai pengenalan suara bawaan iPhone (diproses oleh Apple) untuk mengubah ucapanmu dan lawan bicara menjadi teks untuk diterjemahkan. TourChip tidak menerima atau menyimpan suaramu.";

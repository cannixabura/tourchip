{
  "hosting": {
    "target": "tourchip",
    "public": "hosting",
    "ignore": ["firebase.json", "**/.DS_Store"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/g/**", "destination": "/g.html" },
      { "source": "/v/**", "destination": "/v.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  }
}
